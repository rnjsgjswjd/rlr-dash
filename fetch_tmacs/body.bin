<script type="text/javascript">

// ----------------------- rMateGrid flashVars 설정 시작 -----------------------
 
	// rMateGrid 레이아웃 URL 경로. 반드시 설정하십시오.
	
	var layoutURL = "/web/TG/TG200/TG2100/LayOut/Tg2114_LayOutXml.jsp?stand=all&width=75"
	//var flashVars = "layoutURL="+layoutURL;
	var jsVars = "layoutURL="+layoutURL;
	// 데이타가 JSON형일 경우 넣어줍니다. (설정을 안할경우 xml로 인식하여 오류가 발생합니다)
	jsVars += "&dataType=json";
	jsVars += "&localeChain=en-US";
		
	var gridApp;	// 그리드 rMateGridH5 기초 div
	var gridRoot;	// 데이타와 그리드를 포함하는 객체
	var dataGrid;   // rMateGrid가 로딩된 후 불려지는 함수
	var imageColumn; // 그리드 내 이미지 버튼 클릭 관련 함수
	var gridData  = ""; 	//JSON형식의 데이터를 받을 변수. 
    //flashVars += "&dataType=json";
    //flashVars += "&bridgeName=gridBridge";

    var gridReadyHandler = function(id) {
			gridApp = document.getElementById(id);
			gridRoot = gridApp.getRoot();
		    
		   	var menuItemSelectHandler = function(event) {
		  		contextMenuHandler(event.menuItemCaption);
		   	};
	
		   	var layoutCompleteHandler = function(event) {
		   		dataGrid = gridRoot.getDataGrid();
		   		dataGrid.addEventListener("menuItemSelect", menuItemSelectHandler);
		   		
		   	};
		   	gridRoot.addEventListener("layoutComplete", layoutCompleteHandler);    	
		};
        jsVars += "&rMateOnLoadCallFunction=gridReadyHandler";
		
		// ----------------------- rMateGrid flashVars 설정 끝 -----------------------

	

	

//<![CDATA[
	function init(){	
		//rMateGridInit();	
		//fn_initmenuOpen('','' );
	}
	
	function onMove(){	
		var sido = document.getElementById("sido").value;
		var stand = document.getElementById("stand").value;
		var sYear = document.getElementById("std_year").value;
		var eYear = document.getElementById("end_year").value;
		var jijace_cls = document.getElementById("jijacecls").value;
		
		Temp = eYear - sYear;
		
		if(Temp<0){
			alert("시작년도는 종료년도보다 작아야 합니다.");
			return;
		}
		
		var standNm = '';
		
		if(stand=='death'){
		
			standNm = '사망\n자수';
		
		}else if(stand=='serious'){
		
			standNm = '중상\n자수';
		
		}else{
			standNm = '사상\n자수';
		}
				 
	
		var gridColumn = dataGrid.getColumns()[2];
		gridColumn.setHeaderText(standNm);
	    
		
		setCondition(); // 조회조건 보여주는 함수
		
		showLoading(dataGrid, gridRoot);
		
		var url  = '/web/TG/TG200/TG2100/Tg2114_AJAX.jsp';
		
		inputchk2(sido);
		inputchk2(stand);
		inputchk2(sYear);
		inputchk2(eYear);
		inputchk2(jijace_cls);
		
		var params ="mid=S1894&sido="+sido+"&stand="+stand+"&sYear="+sYear+"&eYear="+eYear+"&jijace_cls="+jijace_cls;
		
		
		gridRoot.removeAll();
		
		sendRequest(url,params,selectState,"POST");	
		

	}
	
	//Callback함수 호출
	function selectState(){
		if(xmlHttp.readyState == 4) {  
	        if(xmlHttp.status == 200) { 	//완료 상태	
				exeAjax(xmlHttp);
				hideLoading(dataGrid, gridRoot);
	        }
	    }
	}
	
	// 출력
	function exeAjax(xmlHttp){		
		var resValue = xmlHttp.responseText;
		gridData = resValue; //JSON형식 데이터를 gridData변수에 할당.
		
		gridData = trim(gridData);
		
		if(gridData=="error"){
			alert("에러가 발생했습니다.");
			document.getElementById('loadM').style.display = 'none';
			return;
		}
		
		if(gridData=="[]"){
		
			alert("데이터가 없습니다.");
			document.getElementById('loadM').style.display = 'none';
			return;
		
		}
		
		gridApp.setData(gridData);
		document.getElementById('loadM').style.display = 'none';
		var sourceBox = document.getElementById('sourceBox');
		if(sourceBox != null){
			sourceBox.style.display = 'block';
		}
		
		document.getElementById("div_chart").style.display = 'none';
		
	}
	
    /** ContextMenu관련 함수.
     * 수정일자 : 2020.11.27
     * 작업자 : 신재석
     */
   function contextMenuHandler(caption) {
       if (caption == "엑셀 다운받기") {
       	logExceldownload('guest','S1894','4.236.93.133');
       	dataGrid.exportTitles = ["지자체별  사고지표 현황"];
	        gridRoot.excelExportSave("", false);
       }
   }
   
   /** 엑셀 다운로드 버튼
     * 수정일자 : 2020.11.27
     * 작업자 : 신재석
     */
   function excelExport() {
       logExceldownload('guest','S1894','4.236.93.133');
		dataGrid.exportTitles = ["지자체별  사고지표 현황"];
       gridRoot.excelExportSave("", false);
   }
	

	
	function radio(param){		
		document.getElementById("stand").value = param;			 
	
	}	
	
	function setCondition(){
	
		var stand = document.getElementById("stand").value;
		var standNm = "";
		
		
		if(stand=="all"){
			standNm = "전체사고";
		}else if(stand=="death"){
			standNm = "사망사고";
		}else{
			standNm = "중상사고";
		}
				
		var std_year = document.getElementById("std_year").value;
		var end_year = document.getElementById("end_year").value;
		var sidoNm = document.getElementById("sido").options[document.getElementById("sido").options.selectedIndex].text;
		var jijaceClsNm = document.getElementById("jijacecls").options[document.getElementById("jijacecls").options.selectedIndex].text;
		var standYear = document.getElementById("stnDate").value;
		
		var condition = "[조회조건] 대상사고: " + standNm + ", 기간: " + std_year + "~" + end_year 
						+ ", 지자체( 광역: " + sidoNm + ",지자체 특성 :" + jijaceClsNm + ")," + " 기준년:" + standYear ;
		
	  
	    document.getElementById('loadM').style.display = 'block';
	    
	    
	}
	
	
	function leadingZeros(n, digits) {
	    var zero = '';
	    n = n.toString();
	    
	    if (n.length < digits) {
	        for (var i = 0; i < digits - n.length; i++)
	            zero += '0';
	    }
	    return zero + n;
	}
	
	 var dataUrl;
		var chartType;
		//차트관련 JS
		function initChart(param){
			
			if(gridData==""){
				alert("조회를 하고나서 차트보기를 하세요.");
				return;
			}
			
			
			var sido = document.getElementById("sido").value;
			var stand = document.getElementById("stand").value;
			var sYear = document.getElementById("std_year").value;
			var eYear = document.getElementById("end_year").value;
			var jijace_cls = document.getElementById("jijacecls").value;
			var selAcc = param;
			
			if(sido!=""){
				alert("광역자치단체가 전국일때만 차트를 보실수 있습니다.");
				return;
			}
			
			if(selAcc==""){			
				alert("차트로 보고싶은 데이터를 선택하세요");
				return;		
			}
			
		    //차트타이틀 설정
		    var chart_text = new Array("발생건수","사망자수","인구1만사고","차1만사고","도로사고","인구1만사고","차1만사상","도로사상");
			chartType = chart_text[param-1];
			
			document.getElementById("div_chart").style.display = 'block';
		    
		 	// 데이터 URL 경로 정의.
		    var url = "";
		    var params = "";
		    
			url = '/web/TG/TG200/TG2100/Chart/Tg2114_BarChart.jsp'; 

		    params ="stand="+stand+"&sYear="+sYear+"&eYear="+eYear+"&sido="+sido+"&jijace_cls="+jijace_cls+"&selAcc="+selAcc;
			
		   /*  var	result = fnWriteChartObject('1001' ,'3D_무지개(Yellow)'
						,url + '?' + params
						,'100%'
						,'400'
						,'1'); */
		    
			dataURL = url + '?' + params;
		    
			
		    //차트생성 시작
			// -----------------------차트 설정 시작-----------------------
			// rMate 차트 생성 준비가 완료된 상태 시 호출할 함수를 지정합니다.
			var chartVars = "rMateOnLoadCallFunction=chartReadyHandler";
			 
			// rMateChart 를 생성합니다.
			// 파라메터 (순서대로) 
			//  1. 차트의 id ( 임의로 지정하십시오. ) 
			//  2. 차트가 위치할 div 의 id (즉, 차트의 부모 div 의 id 입니다.)
			//  3. 차트 생성 시 필요한 환경 변수들의 묶음인 chartVars
			//  4. 차트의 가로 사이즈 (생략 가능, 생략 시 100%)
			//  5. 차트의 세로 사이즈 (생략 가능, 생략 시 100%)
			rMateChartH5.create("chart1", "div_chart", chartVars, "100%", "100%"); 
			// -----------------------차트 설정 끝 -----------------------
		    //차트생성 종료
		    
		    var result_menu = "";
		    var alt_text = new Array("발생건수","사망자수","인구1만사고","차1만사고","도로사고","인구1만사고","차1만사상","도로사상");
		    var span_text = new Array("check","person","people","directions_car","directions","person","directions_car","directions");
		    
		    for (var i = 0; i < 8; i++){
		    	var img_i = "";
		    	img_i = leadingZeros(i+1, 2);
		    	
		    	var img_on = "";
		    	if (param == i+1){ img_on = " class='on'"; }
		    	var param_i = i+1;
		    	
		    	result_menu += "<li><a href='#none' onclick='initChart("+param_i+");'"+img_on+"><span class='material-icons'>"+ span_text[i] +"</span>"+alt_text[i]+"</a></li>";
		    }
		    document.getElementById("chart_menu").innerHTML = result_menu;
		    chart();

		}

		// 차트의 속성인 rMateOnLoadCallFunction 으로 설정된 함수.
		// rMate 차트 준비가 완료된 경우 이 함수가 호출됩니다.
		// 이 함수를 통해 차트에 레이아웃과 데이터를 삽입합니다.
		// 파라메터 : id - rMateChartH5.create() 사용 시 사용자가 지정한 id 입니다.
		// 차트 콜백함수 4개 존재합니다.
		// 1. setLayout - 스트링으로 작성된 레이아웃 XML을 삽입합니다.
		// 2. setData - 배열로 작성된 데이터를 삽입합니다.
		// 3. setLayoutURL - 레이아웃 XML 경로를 지시합니다.
		// 4. setDataURL - 데이터 XML 경로를 지시합니다.
		var layoutStr;
		function chartReadyHandler(id) {
			var title = "지자체별";
			// 라인 차트를 생성하는 레이아웃입니다.(스트링 형태)
			layoutStr = 
		        '<rMateChart backgroundColor="#FFFFFF" borderStyle="none">'
		        +'<Options>'
		           +'<Caption text="' + title + ' '+ chartType +' 현황" />'
		          +'<SubCaption text="(단위. 수)" textAlign="center" />'
		      +'</Options>'
		      +'<NumberFormatter id="numFmt" precision="0" rounding = "nearest"/>'
			      +'<Column3DChart showDataTips="true" columnWidthRatio="0.4">'
			      +'<horizontalAxis>'
		            +'<CategoryAxis categoryField="Area" title="'+ title +'"/>'
		         +'</horizontalAxis>'
		       +'<verticalAxis>'
		          +'<LinearAxis id="vAxis" title="" formatter="{numFmt}"/>'
		      +'</verticalAxis>'
		         +'<verticalAxisRenderers>'
		             +'<Axis3DRenderer axis="{vAxis}" showLine="true" verticalAxisTitleAlignment="horizontal" />'
		       +'</verticalAxisRenderers>'
		        +'<series>'
		            +'<Column3DSeries labelPosition="outside" yField="Count" displayName="" outsideLabelYOffset="-14" formatter = "{numFmt}">'
		                +'<showDataEffect>'
		                    +'<SeriesInterpolate/>'
		                +'</showDataEffect>'
		           +'</Column3DSeries>'
		       +'</series>'
		   +'</Column3DChart>'
	  +'</rMateChart>';
		   document.getElementById(id).setLayout(layoutStr);
		   document.getElementById(id).setDataURL(dataURL);
		    //예제4. 레이아웃 URL, 데이터 URL
	
		  
		}
	 
	 
	 
	//사고현황(세부) 팝업
	function view_detail() {
		var sYear = document.getElementById('std_year').value;
        var eYear = document.getElementById('end_year').value;
        var sidoNm = document.getElementById('sido').options[document.getElementById('sido').selectedIndex].innerHTML;
        var sido = document.getElementById('sido').value;
        var jijaceclsNm = document.getElementById('jijacecls').options[document.getElementById('jijacecls').selectedIndex].innerHTML;
        var jijacecls = document.getElementById('jijacecls').value;
        var stand = document.getElementById("stand").value;
        
        if(eYear < sYear){
            alert('시작년도는 종료년도 보다 작아야 합니다.');
            return false;
        }       
      
	    popupWindow = window.open("/web/TG/TG200/TG2100/Tg2114_detail.jsp?mid=S1894&sYear="+sYear+"&eYear="+eYear+"&sido="+sido+"&jijacecls="+jijacecls+"&stand="+stand
	            , "SagoDetail"
	            , "toolbar=no,location=no,directories=no,status=no,menubar=no,scrollbars=yes,resizable=no,width=1080,height=645,top=50,left=100");
	    popupWindow.focus();
	}
	
	
		
//]]>>

</script>
