    <script type="text/javascript">
   

    function onSatifReg(){

		var satis_rad = null;
		var satis_age = null;
		var satis_job = null;
		var opn_vle = null;
		var f = document.getElementById('form_satif');
    	
    	size = document.getElementsByName("satisScr").length;
    	
    	size_age = document.getElementsByName("satisAge").length;
    	size_job = document.getElementsByName("satisJob").length;
    	
    	opn_vle = document.getElementById('one_line').value;

    	for(var i = 0; i < size; i++){
    		if(document.getElementsByName("satisScr")[i].checked){
    			satis_rad = document.getElementsByName("satisScr")[i].value;
    			break;
    		}
    	}
    	for(var i = 0; i < size_age; i++){
    		if(document.getElementsByName("satisAge")[i].checked){
    			satis_age = document.getElementsByName("satisAge")[i].value;
    			break;
    		}
    	}
    	for(var i = 0; i < size_job; i++){
    		if(document.getElementsByName("satisJob")[i].checked){
    			satis_job = document.getElementsByName("satisJob")[i].value;
    			break;
    		}    		
    	}

		if(satis_rad == null && opn_vle == ""){
			alert("만족도 및 한줄의견에 내용이 없습니다.\n만족도 및 한줄의견을 입력해 주세요");
			f.opn.focus();
			return false;
		}

		if(satis_rad == null){
			satis_rad = "0";
		}
		if(satis_age == null){
			satis_age = "";
		}
		if(satis_job == null){
			satis_job = "";
		}
		
		document.getElementById('menu_id').value="S1894";
		document.getElementById('user_id').value="guest";
		document.getElementById('user_ip').value="4.236.93.133";
		document.getElementById('user_age').value=satis_age;
		document.getElementById('user_job').value=satis_job;
		document.getElementById('satif_value').value=satis_rad;
		
		 
		console.log(f.action);
		targetUrlForm = f;
		f.submit();
    }
	
   
   
    </script>
	
	<form action="/web/satisfaction/SatifRegPrc.jsp" method="post" id="form_satif">
		<input type="hidden" name="menu_id" id="menu_id" value="" />
		<input type="hidden" name="user_id" id="user_id" value="" />
		<input type="hidden" name="user_ip" id="user_ip" value="" />
		<input type="hidden" name="user_age" id="user_age" value="" />
		<input type="hidden" name="user_job" id="user_job" value="" />
		<input type="hidden" name="satif_value" id="satif_value" value="" />
	    <div class="pageResearch">
	        <div class="research_header">
	            <h3><a href="#" style="vertical-align: middle; ">만족도조사</a></h3>
	            <p>화면당 만족도 투표는 <strong>1건/월</strong>이며, 한줄의견(만족도 미체크)은 무제한입니다.</p>
	        </div>
	        <div class="research_content">
	            <ul class="ul01">
	                <li>
	                    <p>연령은 어떻게 되십니까?</p>
	                    <ol>
	                        <li>
	                            <input type="radio" id="count06" name="satisAge" value="1" class="input_radio" checked="checked" title="10대" />
	                            <label for="count06" class="lbl_radio">10대</label>
	                        </li>
	                        <li>
	                            <input type="radio" id="count07" name="satisAge" value="2" class="input_radio" title="20대" />
	                            <label for="count07" class="lbl_radio">20대</label>
	                        </li>
	                        <li>
	                            <input type="radio" id="count08" name="satisAge" value="3" class="input_radio" title="30대" />
	                            <label for="count08" class="lbl_radio">30대</label>
	                        </li>
	                        <li>
	                            <input type="radio" id="count09" name="satisAge" value="4" class="input_radio" title="40대" />
	                            <label for="count09" class="lbl_radio">40대</label>
	                        </li>
	                        <li>
	                            <input type="radio" id="count10" name="satisAge" value="5" class="input_radio" title="50대" />
	                            <label for="count10" class="lbl_radio">50대</label>
	                        </li>
	                        <li>
	                            <input type="radio" id="count11" name="satisAge" value="6" class="input_radio" title="60대 이상" />
	                            <label for="count11" class="lbl_radio">60대 이상</label>
	                        </li>
	                    </ol>
	                </li>
	                <li>
	                    <p>어떤 일을 하고 계십니까?</p>
	                    <ul>
