<!-- 검색조건 데이터 표시 Start -->
<script type="text/javascript">
	function selectFirst() {
	    fs = document.getElementById('sido');
	    fs.options[0]=new Option('전국','');
	     for(j=1 ;j <= arrcode1.length;j++) {    
	         fs.options[j]=new Option(arrcode2[j-1],arrcode1[j-1]);
	     }
	     fs.length=j;
	}
	function selectSecond() {

		var a = document.getElementById('sido').value;
		a = a.substr(0,2);
        fs = document.getElementById('jijacecls');;
        var k = 0;
        if(a == ""){
        	fs.options[0]=new Option('광역시/도','00');
        	fs.options[1]=new Option('30만이상시','01');
        	fs.options[2]=new Option('30만미만시','02');
        	
        	fs.length=3;
        }else{
	        fs.options[0]=new Option('전체','99');
        	
        	fs.length=1;
        }
	}
	
	
	function selectYear() {
		 fs = document.getElementById('std_year');
		 es = document.getElementById('end_year');
	     for(j=0 ;j < jijaceyear.length;j++) {    
	         fs.options[j]=new Option(jijaceyear[j]+"년",jijaceyear[j]);
	         es.options[j]=new Option(jijaceyear[j]+"년",jijaceyear[j]);
	     }
	    
	     fs.length=j;
	     es.length=j;
	}
    
	selectFirst();
    selectYear();    
    document.getElementById('stnDate').value = sStandDate.substr(0,4)+"년 " + sStandDate.substr(4,2)+"월";
</script>
<!-- 검색조건 데이터 표시 END -->
