<script type="text/javascript">
	// 시도리스트 코드
	arrcode1 = new Array;
	// 시도리스트 명
	arrcode2 = new Array;
	
	// 지자체리스트 코드 	
	arrcode3 = new Array;
	// 지자체리스트 명 
	arrcode4 = new Array;
	
	// 업종 코드 	
	arrcode5 = new Array;
	// 업종 명 
	arrcode6 = new Array;
	
	// 도로종류 코드 	
	arrcode7 = new Array;
	// 도로종류명 
	arrcode8 = new Array;
	
	// 도로명 코드 	
	arrcode9 = new Array;
	// 도로명 
	arrcode10 = new Array;
	
	// 이동편의시설 코드 
	arrcode11 = new Array;
	// 이동편의시설 명 
	arrcode12 = new Array;
	
	// 수단시설 코드 
	arrcode13 = new Array;
	// 수단시설 명 
	arrcode14 = new Array;
	
	
	
	jijaceyear = new Array;
	
	corpyear   = new Array;
	
	nujukyear = new Array;	
	
	strgchk = "Y";
	
	sStandDate = "";
	
	nujukStandDate = "";
	
	transStandDate = "";
	
function SetArray(gbn,idx,f1,f2){
	if(gbn == "1"){
		arrcode1[idx] = f1;
		arrcode2[idx] = f2;
	}
	else if(gbn == "2")  {
		arrcode3[idx] = f1;
		arrcode4[idx] = f2;
	}else if(gbn == "3")  {
		arrcode5[idx] = f1;
		arrcode6[idx] = f2;
	}else if(gbn == '4'){
		arrcode7[idx] = f1;
		arrcode8[idx] = f2;
	}else if(gbn == '5'){
		arrcode9[idx] = f1;
		arrcode10[idx] = f2;
	}else if(gbn == '6'){
		arrcode11[idx] = f1;
		arrcode12[idx] = f2;
	}else if(gbn == '7'){
		arrcode13[idx] = f1;
		arrcode14[idx] = f2;
	}
	
}

function SetYear(gbn,idx,f1){
	if(gbn == "1"){
		jijaceyear[idx] = f1;
	}
	else if(gbn == "2"){
		corpyear[idx] = f1;
	}else if(gbn == "3"){
		nujukyear[idx] = f1;
	}
}	
</script>

