<script type="text/javascript">

function fn_goDown5(file_id){
	
	if(file_id == ''){
        alert("준비중입니다.")
    }
    
	if(file_id != ''){
		location.href= "/web/common/FileCommDownloadManual.jsp?fileId=" + file_id;
	}
	return false;
}

function fnOpenGis(){
	//window.open("http://tmacs.kotsa.or.kr/webgis/main.do", "_blank");
	 var myForm = document.popForm;
	 var url = "https://tmacs.kotsa.or.kr/webgis/main.do";
	 var winl = screen.width;
     var wint = screen.height;
	 var settings  ='height='+wint+',';
	     settings +='width='+winl+',';
	     settings +='top='+0+',';
	     settings +='left='+0+',';
	     settings +='scrollbars=yes,';
	     settings +='resizable=yes, status=yes';
	 newwin = window.open(url,"yPop",settings);
	 myForm.action =url; 
	 myForm.method="post";
	 myForm.target="yPop";
	 myForm.submit();
}

function fnOpenBlank(url){
	window.open(url, "_blank");
}

function fnTg7300Js(){
	window.open("https://dtis.kotsa.or.kr", "dtisPop");
}
</script>
